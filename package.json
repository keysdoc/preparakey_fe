{
  "name": "preparakey-frontend",
  "version": "16.6.0",
  "private": true,
  "description": "PWA estática para simulados de preparação PMP.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "node scripts/build.mjs",
    "import:knowledge": "node scripts/import-knowledge.mjs",
    "lint": "eslint . --max-warnings=0",
    "security": "node scripts/security-check.mjs",
    "test": "node --test",
    "validate:workflows": "node scripts/validate-workflows.mjs",
    "check": "npm run lint && npm run security && npm test && npm run validate:workflows && npm run build"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "yaml": "2.9.1"
  }
}
